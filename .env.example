# Use URL-safe random passwords. Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
POSTGRES_PASSWORD=
AEGIS_APP_ROLE_PASSWORD=
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
AEGIS_SECRET_KEYS=
AEGIS_ALLOWED_HOSTS=["localhost","127.0.0.1"]
AEGIS_WRITEBACK_ENABLED=false
AEGIS_PLAN_EXECUTION_ENABLED=false
# Local non-Docker development only:
# AEGIS_ADMIN_DATABASE_URL=postgresql+psycopg://aegis_owner:password@127.0.0.1:5432/aegis
# AEGIS_DATABASE_URL=postgresql+psycopg://aegis_app:password@127.0.0.1:5432/aegis
# AEGIS_COOKIE_SECURE=false

# Default account authentication: Google OIDC. Supply these before real sign-in.
AEGIS_AUTH_MODE=google
AEGIS_GOOGLE_CLIENT_ID=
AEGIS_GOOGLE_CLIENT_SECRET=
AEGIS_GOOGLE_REDIRECT_URI=
# Exact callback: https://YOUR_DOMAIN/api/v1/auth/google/callback
AEGIS_GOOGLE_ALLOWED_DOMAINS=[]
# Platform fixtures are the default. They never send requests to real merchants.
AEGIS_INTEGRATION_MODE=mock
AEGIS_REQUIRE_RECONCILIATION=true
